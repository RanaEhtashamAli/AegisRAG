# Application
APP_NAME=AegisRAG
APP_ENV=local
API_V1_PREFIX=/api/v1

# Security — change SECRET_KEY before any deployment
SECRET_KEY=change-me-to-a-random-64-char-string-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegisrag
POSTGRES_USER=aegisrag
POSTGRES_PASSWORD=aegisrag
# DATABASE_URL is auto-assembled from the above; override here if needed
# DATABASE_URL=postgresql+psycopg2://aegisrag:aegisrag@localhost:5432/aegisrag

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=aegisrag_chunks

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# File storage
UPLOAD_DIR=/tmp/aegisrag_uploads
